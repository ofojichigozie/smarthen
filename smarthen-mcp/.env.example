# ---------------------------------------------------------------------------
# Smarthen MCP — Environment Configuration
# ---------------------------------------------------------------------------

# Transport mode: "stdio" for local development, "http" for production
MCP_TRANSPORT=stdio

# Port for Streamable HTTP transport (only used when MCP_TRANSPORT=http)
MCP_PORT=3001

# Backend API base URL (must include /api)
BACKEND_URL=http://localhost:5000/api

# Service account key used to authenticate with the backend.
# This value must match MCP_SERVICE_API_KEY in smarthen-backend/.env
SERVICE_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Temporary (Phase 2–6 only) — removed in Phase 7
# ---------------------------------------------------------------------------
# Admin JWT obtained via POST /api/auth/login. Used for local testing
# before the service-account middleware is added to the backend.
ADMIN_JWT=