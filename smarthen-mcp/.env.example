# ---------------------------------------------------------------------------
# Smarthen MCP — Environment Configuration
# ---------------------------------------------------------------------------

# Transport mode: "stdio" for local development, "http" for production
MCP_TRANSPORT=http

# Port for Streamable HTTP transport (only used when MCP_TRANSPORT=http)
MCP_PORT=3001

# Smarthen backend API base URL (must include /api)
API_URL=http://localhost:5000/api

# Service account key used to authenticate with the backend.
MCP_SERVICE_API_KEY=change-me-to-a-long-random-string

# Authentication for MCP clients calling this server.
# Leave empty to disable auth (local dev only).
MCP_CLIENT_API_KEY=change-me-to-a-long-random-string

CORS_ORIGIN=*