# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aqms

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# CORS (set to frontend URL in production)
CORS_ORIGIN=http://localhost:5173

# IoT Device authentication key
# ESP32 must send this in the X-API-Key header
HARDWARE_API_KEY=change_this_to_a_secret_device_key
